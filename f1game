<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Formula 1 Fan Hub</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        /* Custom styles to enhance Tailwind */
        body {
            font-family: 'Inter', sans-serif;
            background-color: #0d0d0d; /* Dark background */
            color: #f5f5f5; /* Light text */
            overflow-x: hidden; /* Prevent horizontal scrolling */
        }

        /* Loader specific styles */
        .loader-wrapper {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: #0d0d0d; /* Dark background for loader */
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 9999;
            transition: opacity 0.5s ease-out;
        }

        .loader {
            border: 8px solid rgba(255, 255, 255, 0.2);
            border-top: 8px solid #E10600; /* F1 Red */
            border-radius: 50%;
            width: 60px;
            height: 60px;
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .hidden-loader {
            opacity: 0;
            pointer-events: none;
        }

        /* Hero section background overlay for subtle effect */
        .hero-background {
            background-image: linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.7)), url('https://placehold.co/1920x1080/0d0d0d/E10600?text=F1+Track');
            background-size: cover;
            background-position: center;
            min-height: 80vh; /* Responsive height */
        }
    </style>
</head>
<body class="antialiased">

    <!-- Loader -->
    <div id="loader-wrapper" class="loader-wrapper">
        <div class="loader"></div>
    </div>

    <!-- Main Content -->
    <div id="main-content" class="min-h-screen flex flex-col hidden-loader">
        <!-- Navigation Bar -->
        <nav class="bg-gray-900 p-4 shadow-lg sticky top-0 z-50">
            <div class="container mx-auto flex flex-col md:flex-row justify-between items-center">
                <!-- Logo/Site Title -->
                <a href="#" class="text-white text-3xl font-extrabold flex items-center mb-4 md:mb-0">
                    <svg class="w-8 h-8 mr-2 text-red-600" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 15H9v-2h2v2zm0-4H9v-2h2v2zm0-4H9V7h2v2zm4 8h-2v-2h2v2zm0-4h-2v-2h2v2zm0-4h-2V7h2v2z"/>
                    </svg>
                    F1 Fan Hub
                </a>
                <!-- Navigation Links -->
                <div class="flex flex-wrap justify-center md:justify-end gap-x-6 gap-y-2 text-lg">
                    <a href="#" class="text-gray-300 hover:text-red-600 transition duration-300 rounded-md px-3 py-2">Home</a>
                    <a href="#" class="text-gray-300 hover:text-red-600 transition duration-300 rounded-md px-3 py-2">News</a>
                    <a href="#" class="text-gray-300 hover:text-red-600 transition duration-300 rounded-md px-3 py-2">Drivers</a>
                    <a href="#" class="text-gray-300 hover:text-red-600 transition duration-300 rounded-md px-3 py-2">Teams</a>
                    <a href="#" class="text-gray-300 hover:text-red-600 transition duration-300 rounded-md px-3 py-2">Calendar</a>
                </div>
            </div>
        </nav>

        <!-- Hero Section -->
        <header class="hero-background flex items-center justify-center text-center py-20 px-4">
            <div class="max-w-4xl">
                <h1 class="text-5xl md:text-7xl font-extrabold text-white leading-tight mb-6">
                    Feel the Speed. Live the Race.
                </h1>
                <p class="text-xl md:text-2xl text-gray-200 mb-8">
                    Your ultimate source for Formula 1 news, insights, and action.
                </p>
                <button class="bg-red-600 hover:bg-red-700 text-white font-bold py-4 px-8 rounded-full shadow-lg transition duration-300 transform hover:scale-105">
                    Explore Latest Races
                </button>
            </div>
        </header>

        <!-- Featured News Section -->
        <section class="py-16 px-4 bg-gray-800">
            <div class="container mx-auto">
                <h2 class="text-4xl font-bold text-center text-white mb-12">Latest F1 News</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    <!-- News Card 1 -->
                    <div class="bg-gray-900 rounded-lg shadow-lg overflow-hidden transform transition duration-300 hover:scale-105 hover:shadow-xl">
                        <img src="https://placehold.co/600x400/222222/E10600?text=Race+Highlights" alt="News Image" class="w-full h-48 object-cover">
                        <div class="p-6">
                            <h3 class="text-2xl font-semibold text-white mb-3">Verstappen Dominates Spanish Grand Prix</h3>
                            <p class="text-gray-300 text-base mb-4">
                                Max Verstappen secured another commanding victory, extending his lead in the championship.
                            </p>
                            <a href="#" class="text-red-600 hover:text-red-700 font-medium transition duration-300">Read More &rarr;</a>
                        </div>
                    </div>
                    <!-- News Card 2 -->
                    <div class="bg-gray-900 rounded-lg shadow-lg overflow-hidden transform transition duration-300 hover:scale-105 hover:shadow-xl">
                        <img src="https://placehold.co/600x400/222222/E10600?text=Team+Update" alt="News Image" class="w-full h-48 object-cover">
                        <div class="p-6">
                            <h3 class="text-2xl font-semibold text-white mb-3">Mercedes Unveils Major Car Upgrades</h3>
                            <p class="text-gray-300 text-base mb-4">
                                The Silver Arrows hope to close the gap with significant aerodynamic improvements.
                            </p>
                            <a href="#" class="text-red-600 hover:text-red-700 font-medium transition duration-300">Read More &rarr;</a>
                        </div>
                    </div>
                    <!-- News Card 3 -->
                    <div class="bg-gray-900 rounded-lg shadow-lg overflow-hidden transform transition duration-300 hover:scale-105 hover:shadow-xl">
                        <img src="https://placehold.co/600x400/222222/E10600?text=Driver+Interview" alt="News Image" class="w-full h-48 object-cover">
                        <div class="p-6">
                            <h3 class="text-2xl font-semibold text-white mb-3">Leclerc: "We're Still Fighting for the Title"</h3>
                            <p class="text-gray-300 text-base mb-4">
                                Charles Leclerc remains optimistic despite recent setbacks for Ferrari.
                            </p>
                            <a href="#" class="text-red-600 hover:text-red-700 font-medium transition duration-300">Read More &rarr;</a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Championship Standings Placeholder Section -->
        <section class="py-16 px-4 bg-gray-900">
            <div class="container mx-auto text-center">
                <h2 class="text-4xl font-bold text-white mb-8">Championship Standings</h2>
                <div class="bg-gray-800 p-8 rounded-lg shadow-lg">
                    <p class="text-gray-300 text-lg mb-4">
                        (Placeholder for dynamic standings data)
                    </p>
                    <p class="text-gray-400">
                        Stay tuned for real-time updates after every race!
                    </p>
                    <button class="mt-6 bg-red-600 hover:bg-red-700 text-white font-bold py-3 px-6 rounded-full transition duration-300 transform hover:scale-105">
                        View Full Standings
                    </button>
                </div>
            </div>
        </section>

        <!-- Footer -->
        <footer class="bg-gray-900 py-8 px-4 mt-auto">
            <div class="container mx-auto text-center text-gray-400">
                <p>&copy; 2025 F1 Fan Hub. All rights reserved.</p>
                <div class="flex justify-center space-x-6 mt-4">
                    <a href="#" class="hover:text-red-600 transition duration-300">Privacy Policy</a>
                    <a href="#" class="hover:text-red-600 transition duration-300">Terms of Service</a>
                    <a href="#" class="hover:text-red-600 transition duration-300">Contact Us</a>
                </div>
            </div>
        </footer>
    </div>

    <script>
        // JavaScript for the loader
        window.addEventListener('load', function() {
            const loaderWrapper = document.getElementById('loader-wrapper');
            const mainContent = document.getElementById('main-content');

            // Simulate a delay for demonstration purposes (remove in production if not needed)
            setTimeout(() => {
                loaderWrapper.classList.add('hidden-loader');
                // Remove the loader from the DOM after the transition completes
                loaderWrapper.addEventListener('transitionend', () => {
                    loaderWrapper.remove();
                });
                mainContent.classList.remove('hidden-loader'); // Show the main content
            }, 1000); // 1 second delay
        });
    </script>
</body>
</html>
